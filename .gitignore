# =============================================
# VantiQuity Pulse — .gitignore
# =============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build
dist/
build/
*.local

# Environment variables (NEVER commit these)
.env
.env.local
.env.*.local
backend/.env

# Database
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
.eggs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Misc
*.tgz
.cache/
