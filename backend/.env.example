# =============================================
# VantiQuity Pulse — Environment Variables
# Copy this file to .env and fill in your keys
# =============================================

# Database
DATABASE_URL=sqlite:///./vantiquity_pulse.db

# Razorpay (India — UPI, Cards, NetBanking)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Stripe (International — Cards, Google Pay, Apple Pay)
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# CORS — allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL (for Stripe checkout redirects)
FRONTEND_URL=http://localhost:5173
